# HD ERP Docs Sync - Environment Variables
# These are written to .env.erp-docs in the target project by the CLI setup.
# Copy to .env.erp-docs and fill in real values.

# Base URL of the HD ERP Permission API (no trailing slash)
# Default: https://hd-erp-permission.dev.hdwebsoft.co
PERMISSION_API_PUBLIC_URL=https://hd-erp-permission.dev.hdwebsoft.co

# Sync token (starts with hdk_) — obtain from ERP admin
ERP_DOCS_SYNC_TOKEN=hdk_your_sync_token_here

# ---------------------------------------------------------------------------
# CI / GitHub Actions secrets (set in repo Settings → Secrets → Actions)
# ---------------------------------------------------------------------------

# npm access token for publishing @ktran-1604/docs-sync
# Generate at: https://www.npmjs.com/settings/<username>/tokens (type: Automation)
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxx
